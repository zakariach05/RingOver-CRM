{
  "name": "ringover-backend",
  "version": "1.0.0",
  "description": "RingOver CRM Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node node_modules/prisma/build/index.js generate && node node_modules/tsx/dist/cli.mjs watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "node node_modules/jest/bin/jest.js --runInBand --forceExit",
    "test:watch": "node node_modules/jest/bin/jest.js --runInBand --forceExit --watch",
    "db:migrate": "node node_modules/prisma/build/index.js migrate dev",
    "db:studio": "node node_modules/prisma/build/index.js studio",
    "db:seed": "node node_modules/tsx/dist/cli.mjs src/utils/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "prisma": "^5.10.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
