generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// DealStage values: LEAD | QUALIFIED | PROPOSAL | NEGOTIATION | WON | LOST
// CallDirection values: INBOUND | OUTBOUND
// CallStatus values: INITIATED | RINGING | ANSWERED | COMPLETED | FAILED | NO_ANSWER | MISSED
// Note: SQLite doesn't support native enums, so these are stored as String with app-level validation.

model Team {
  id                String            @id @default(cuid())
  name              String
  createdAt         DateTime          @default(now())
  users             User[]
  invitations       Invitation[]
  contacts          Contact[]
  deals             Deal[]
  calls             Call[]
  smsConversations  SmsConversation[]
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  name            String
  role            String   @default("AGENT") // ADMIN | MANAGER | AGENT
  status          String   @default("ACTIVE") // ACTIVE | INACTIVE
  phoneExtension  String?
  resetToken      String?
  resetTokenExpiry DateTime?
  teamId          String
  team            Team     @relation(fields: [teamId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sentInvitations Invitation[] @relation("InvitedBy")
  ownedContacts   Contact[]    @relation("ContactOwner")
  ownedDeals      Deal[]         @relation("DealOwner")
  calls           Call[]         @relation("CallAgent")

  @@index([email])
  @@index([teamId])
  @@index([resetToken])
}

model Invitation {
  id          String   @id @default(cuid())
  email       String
  role        String   // ADMIN | MANAGER | AGENT
  token       String   @unique
  status      String   @default("PENDING") // PENDING | ACCEPTED | EXPIRED
  expiresAt   DateTime
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id])
  invitedById String
  invitedBy   User     @relation("InvitedBy", fields: [invitedById], references: [id])
  createdAt   DateTime @default(now())

  @@unique([email, status], name: "unique_pending_email")
  @@index([token])
  @@index([teamId])
}

model Contact {
  id               String            @id @default(cuid())
  name             String
  company          String?
  phone            String
  email            String?
  tags             String?           // Stored as JSON string
  notes            String?

  ownerId          String?
  owner            User?             @relation("ContactOwner", fields: [ownerId], references: [id])

  teamId           String
  team             Team              @relation(fields: [teamId], references: [id])

  deals            Deal[]
  calls            Call[]
  smsConversations SmsConversation[]

  deletedAt        DateTime?         // Soft delete pour RGPD
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([teamId, name])
  @@index([teamId, phone])
  @@index([teamId, email])
}

model Deal {
  id        String    @id @default(cuid())
  title     String
  value     Float
  stage     String    @default("LEAD")
  contactId String?
  contact   Contact?  @relation(fields: [contactId], references: [id])
  ownerId   String
  owner     User      @relation("DealOwner", fields: [ownerId], references: [id])
  teamId    String
  team      Team      @relation(fields: [teamId], references: [id])
  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([teamId, stage])
}

model Call {
  id            String        @id @default(cuid())
  fromNumber    String
  toNumber      String
  direction     String
  status        String
  duration      Int?
  agentId       String
  agent         User          @relation("CallAgent", fields: [agentId], references: [id])
  contactId     String?
  contact       Contact?      @relation(fields: [contactId], references: [id])
  note          String?
  recordingUrl  String?
  twilioCallSid String?
  startedAt     DateTime      @default(now())
  endedAt       DateTime?
  teamId        String
  team          Team          @relation(fields: [teamId], references: [id])

  @@index([teamId, agentId, startedAt])
  @@index([teamId, status])
}

model SmsConversation {
  id          String       @id @default(cuid())
  contactId   String
  contact     Contact      @relation(fields: [contactId], references: [id])
  teamId      String
  team        Team         @relation(fields: [teamId], references: [id])
  lastMessage String?
  lastAt      DateTime?
  unreadCount Int          @default(0)
  messages    SmsMessage[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([contactId, teamId])
  @@index([teamId, lastAt])
}

model SmsMessage {
  id             String          @id @default(cuid())
  conversationId String
  conversation   SmsConversation @relation(fields: [conversationId], references: [id])
  direction      String          // INBOUND | OUTBOUND
  body           String
  status         String          @default("SENT") // SENT | DELIVERED | FAILED | RECEIVED
  ringoverSmsId  String?
  sentAt         DateTime        @default(now())

  @@index([conversationId, sentAt])
}

